    {
      "name": "API-005 Volunteer Assignment Invalid Request - 401",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"disasterReportId\": \"00000000-0000-0000-0000-000000000000\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/volunteer-assignment/recommend",
          "host": ["{{baseUrl}}"],
          "path": ["api", "volunteer-assignment", "recommend"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Unauthenticated request is rejected', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
              "});"
            ]
          }
        }
      ]
    }
  ]
